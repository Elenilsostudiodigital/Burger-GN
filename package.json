{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||'';if(!ua.includes('pnpm')){console.error('Use pnpm instead');process.exit(1)}\"",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev:api": "dotenv -e .env -- pnpm --filter @workspace/api-server run dev",
    "dev:web": "dotenv -e .env.frontend -- pnpm --filter @workspace/burger-gn run dev",
    "dev:db": "pnpm --filter @workspace/scripts run db:embedded",
    "db:push": "dotenv -e .env -- pnpm --filter @workspace/db run push",
    "db:migrate": "dotenv -e .env -- pnpm --filter @workspace/scripts run migrate-multi-tenant",
    "db:migrate-clube": "dotenv -e .env -- pnpm --filter @workspace/scripts run migrate-clube",
    "db:migrate-delivery-streets": "dotenv -e .env -- pnpm --filter @workspace/scripts run migrate-delivery-streets"
  },
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "core-js",
      "@swc/core",
      "msw",
      "unrs-resolver",
      "embedded-postgres",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/windows-x64"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "dotenv-cli": "^8.0.0",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
